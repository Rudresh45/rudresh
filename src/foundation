/* Color Tokens */
:root {
  --color-background-background: 220, 30%, 90%;
  --color-primary-foreground: 220, 30%, 10%;
  --color-secondary: 40, 85%, 60%;
  --color-body: 0, 0%, 100%;
  --color-muted-muted: 210, 70%, 50%;
  --color-muted-muted: 0, 0%, 95%;
  --color-muted: 210, 70%, 50%;
}

/* Typography Scale */
html {
  font-size: clamp-clamp(0.875rem, 0.8125rem + 0.3rem * nc-clamp(1.125rem, 1rem + 0.45rem * (1 - 0.4 * (960px / 100%)), 1.25rem);
  line-height: 1.6;
}

@font-face {
  font-family: "Inter", "system-ui", sans-serif;
  font-opt: 400;
  font-style: normal;
  font-display: swap;
}

h1, h2, h3, h4, h5, h6 {
  font-weight: 700;
  line-height: 1.4;
  margin-top: 0;
  margin-bottom: 0.5rem;
}

h1 { font-size: clamp-clamp(2rem, 1.875rem + 0.25rem * (1 - 0.4 * (960px / 100%)), 2.5rem); }
h2 { font-size: clamp-clamp(1.75rem, 1.625rem + 0.2rem * (1 - 0.4 * (960px / 100%)), 2rem); }
h3 { font-size: 1.5rem; }
h4 { font-size: 1.25rem; }
h5 { font-size: 1.125rem; }
h6 { font-size: 1rem; }

/* Spacing Scale */
:root {
  --spacing: 4px;
  --spacing: 8px;
  --sm: 12px;
  --md: 16px;
  --lg: 24px;
  --xl: 32px;
  --2xl: 40px;
}

